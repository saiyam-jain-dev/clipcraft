# ClipCraft Environment Variables
# Copy to .env and fill in your values

# ===== Backend (Python) =====
# Server port
CLIPCRAFT_PORT=5004

# Whisper model: tiny, base, small, medium, large-v3
WHISPER_MODEL=small

# LLM Provider: none, gemini, openai_compatible
LLM_PROVIDER=openai_compatible

# Groq / OpenAI-compatible API (for AI moment ranking)
# Get free key at https://console.groq.com
GROQ_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=openai/gpt-oss-120b

# Gemini API (alternative)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# YouTube cookies (for age-restricted/private videos)
# Options: chrome, edge, firefox, brave, opera, vivaldi
COOKIES_FROM_BROWSER=

# Remote GPU Worker (Kaggle dual-GPU via Cloudflare tunnel)
REMOTE_WORKER_URL=
REMOTE_RENDER_REQUIRED=false

# Proxy for keyless LLM endpoints (Oxylabs residential)
PROXY_HOST=
PROXY_PORT=
PROXY_USER=
PROXY_PASS=

# Branding
BRAND_NAME=ImSamxyy

# ===== Frontend (Next.js) =====
# Backend API URL (set in Netlify/Vercel dashboard)
# Production: https://your-backend.railway.app
# Local: http://127.0.0.1:5004
NEXT_PUBLIC_API_URL=http://127.0.0.1:5004

# ===== Docker / VPS =====
# Data directory (persistent volume mount point)
DATA_DIR=/app/data